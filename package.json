{
  "name": "dsh-minimax-asr",
  "version": "0.1.0",
  "description": "MiniMax speech-to-text (asr-1.0) as a global DeepSeek Harness plugin: a transcribe_audio tool, a settings card, and composer voice input.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "minimax",
    "asr",
    "speech-to-text",
    "transcription",
    "voice-input"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/client-smoke.mjs",
    "test:installed": "node tests/installed-check.mjs",
    "test:tool": "node tests/smoke.mjs",
    "test:route": "node tests/route-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  }
}
